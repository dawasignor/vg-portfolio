# Copy this file to .env and fill it in. .env is gitignored: never commit a key.
# Used by `npm run stylize` (scripts/stylize.mjs) only; the website never sees these.

# Your OpenRouter API key.
OPENROUTER_API_KEY=

# The image model to use: your choice, as it sets the cost per image.
# List the models that can generate images:
#   curl "https://openrouter.ai/api/v1/models?output_modalities=image"
OPENROUTER_IMAGE_MODEL=
